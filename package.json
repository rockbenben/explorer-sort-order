{
  "name": "explorer-sort-order",
  "displayName": "Explorer Sort Order",
  "version": "1.0.0",
  "description": "Toggle explorer file sorting with a keyboard shortcut, toolbar button, or status bar. Supports all 6 sort modes with configurable quick toggle.",
  "publisher": "qingshun",
  "license": "MIT",
  "icon": "logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/rockbenben/explorer-sort-order.git"
  },
  "bugs": {
    "url": "https://github.com/rockbenben/explorer-sort-order/issues"
  },
  "homepage": "https://github.com/rockbenben/explorer-sort-order#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Explorer Sort Order",
      "properties": {
        "explorerSortOrder.toggleA": {
          "type": "string",
          "default": "default",
          "enum": [
            "default",
            "modified",
            "type",
            "filesFirst",
            "mixed",
            "foldersNestsFiles"
          ],
          "enumDescriptions": [
            "By name, folders first",
            "By last modified date",
            "By extension type",
            "Files before folders",
            "Files and folders mixed",
            "Nested files before others"
          ],
          "description": "First sort mode for toggle"
        },
        "explorerSortOrder.toggleB": {
          "type": "string",
          "default": "modified",
          "enum": [
            "default",
            "modified",
            "type",
            "filesFirst",
            "mixed",
            "foldersNestsFiles"
          ],
          "enumDescriptions": [
            "By name, folders first",
            "By last modified date",
            "By extension type",
            "Files before folders",
            "Files and folders mixed",
            "Nested files before others"
          ],
          "description": "Second sort mode for toggle"
        }
      }
    },
    "commands": [
      {
        "command": "extension.toggleExplorerSortOrder",
        "title": "Toggle Explorer Sort Order",
        "icon": "$(list-filter)"
      },
      {
        "command": "extension.selectExplorerSortOrder",
        "title": "Select Explorer Sort Order"
      }
    ],
    "keybindings": [
      {
        "command": "extension.toggleExplorerSortOrder",
        "key": "ctrl+f10",
        "mac": "cmd+f10",
        "when": "explorerViewletVisible"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "extension.toggleExplorerSortOrder",
          "when": "view == workbench.explorer.fileView",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "yarn run package",
    "generated": "vsce package",
    "compile": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "typecheck": "tsc --noEmit",
    "watch": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap --watch",
    "package": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --minify",
    "pretest": "yarn run typecheck && yarn run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "esbuild": "^0.27.3",
    "eslint": "^9.22.0",
    "typescript": "^5.7.3"
  }
}
